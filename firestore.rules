rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidDeletionRequest(data) {
      return data.keys().hasAll(['instagramHandle', 'status', 'requestedAt']) &&
             data.keys().hasOnly(['instagramHandle', 'status', 'requestedAt', 'contactEmail', 'createdAt']) &&
             data.instagramHandle is string && data.instagramHandle.size() >= 1 && data.instagramHandle.size() <= 100 &&
             data.status == 'pending' &&
             data.requestedAt is string && data.requestedAt.size() <= 64 &&
             (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 200));
    }

    match /deletion_requests/{requestId} {
      allow create: if isValidId(requestId) && isValidDeletionRequest(incoming());
      allow read, update, delete: if false;
    }
  }
}
